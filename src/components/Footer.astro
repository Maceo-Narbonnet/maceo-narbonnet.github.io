---
import { content, profile, type Lang } from '../data/site';
interface Props { lang: Lang }
const { lang } = Astro.props;
const t = content[lang];
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="container">
    <span>© {year} {profile.name} · {t.footer.built}</span>
    <span>
      <a href={`${profile.github}/maceo-narbonnet.github.io`} target="_blank" rel="noopener">{t.footer.source} ↗</a>
    </span>
  </div>
</footer>
