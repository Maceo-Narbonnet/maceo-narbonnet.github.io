---
import { getCollection, render, type CollectionEntry } from 'astro:content';
import Base from '../layouts/Base.astro';
import { content, paths, type Lang } from '../data/site';

interface Props {
  lang: Lang;
  entry: CollectionEntry<'projects'>;
}
const { lang, entry } = Astro.props;
const d = entry.data;
const t = content[lang].project;
const other: Lang = lang === 'fr' ? 'en' : 'fr';

const { Content, headings } = await render(entry);
const toc = headings.filter((h) => h.depth === 2 || h.depth === 3);

const all = (await getCollection('projects', (p) => p.data.lang === lang)).sort((a, b) => a.data.order - b.data.order);
const idx = all.findIndex((p) => p.data.key === d.key);
const prev = idx > 0 ? all[idx - 1] : null;
const next = idx < all.length - 1 ? all[idx + 1] : null;
const others = all.filter((p) => p.data.key !== d.key).slice(0, 3);

const ghIcon = '<path d="M12 2a10 10 0 00-3.2 19.5c.5.1.7-.2.7-.5v-1.8c-2.8.6-3.4-1.2-3.4-1.2-.4-1.1-1.1-1.5-1.1-1.5-.9-.6.1-.6.1-.6 1 .1 1.5 1 1.5 1 .9 1.6 2.4 1.1 3 .9.1-.7.4-1.1.6-1.4-2.2-.2-4.6-1.1-4.6-5a3.9 3.9 0 011-2.7 3.6 3.6 0 01.1-2.7s.8-.3 2.8 1a9.5 9.5 0 015 0c1.9-1.3 2.8-1 2.8-1a3.6 3.6 0 01.1 2.7 3.9 3.9 0 011 2.7c0 3.9-2.4 4.8-4.6 5 .4.3.7.9.7 1.9v2.8c0 .3.2.6.7.5A10 10 0 0012 2z"/>';
const linkIcon = '<path d="M10 14a5 5 0 007 0l3-3a5 5 0 00-7-7l-1 1"/><path d="M14 10a5 5 0 00-7 0l-3 3a5 5 0 007 7l1-1"/>';
---

<Base lang={lang} altHref={paths.project(other, d.key)} title={d.title} description={d.tagline} ogImage={d.cover}>
  <section class="project-hero">
    <div class="container">
      <div class="back-row"><a class="back" href={paths.projectsAnchor[lang]}>← {t.back}</a></div>
      <div class="eyebrow">{d.kind === 'internship' ? t.internship : t.project} · {d.period}</div>
      <h1>{d.title}</h1>
      <p class="tagline">{d.tagline}</p>

      <div class="meta-grid">
        <div><div class="k">{t.period}</div><div class="v">{d.period}</div></div>
        <div><div class="k">{t.context}</div><div class="v">{d.context}</div></div>
        {d.role && <div><div class="k">{t.role}</div><div class="v">{d.role}</div></div>}
        <div><div class="k">{t.stack}</div><div class="v stack">{d.stack.map((s) => <span class="tag">{s}</span>)}</div></div>
      </div>

      {d.results.length > 0 && (
        <div class="results-strip">
          {d.results.map((r) => <div class="r"><b>{r.value}</b><span>{r.label}</span></div>)}
        </div>
      )}

      <div class="project-cover">
        <img src={d.cover} alt={d.coverAlt} class:list={[{ contain: d.coverFit === 'contain' }]} fetchpriority="high" />
      </div>
    </div>
  </section>

  <div class="container project-layout">
    <article class="prose">
      <Content />

      <div class="pager">
        {prev ? (
          <a href={paths.project(lang, prev.data.key)}><div class="lbl">← {t.prev}</div><div class="ttl">{prev.data.title}</div></a>
        ) : <span></span>}
        {next ? (
          <a class="next" href={paths.project(lang, next.data.key)}><div class="lbl">{t.next} →</div><div class="ttl">{next.data.title}</div></a>
        ) : <span></span>}
      </div>
    </article>

    <aside class="project-aside">
      {(d.github || d.links.length > 0) && (
        <div class="aside-box">
          <h4>{t.source}</h4>
          {d.github && (
            <a href={d.github} target="_blank" rel="noopener">
              <svg viewBox="0 0 24 24" fill="currentColor" set:html={ghIcon} />
              {d.github.replace('https://github.com/', '')}
            </a>
          )}
          {d.links.map((l) => (
            <a href={l.url} target="_blank" rel="noopener">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" set:html={linkIcon} />
              {l.label}
            </a>
          ))}
        </div>
      )}
      {toc.length > 0 && (
        <div class="aside-box toc">
          <h4>{lang === 'fr' ? 'Sommaire' : 'Contents'}</h4>
          {toc.map((h) => <a href={`#${h.slug}`} class:list={[`depth-${h.depth}`]}>{h.text}</a>)}
        </div>
      )}
      <div class="aside-box">
        <h4>{t.otherProjects}</h4>
        {others.map((p) => <a href={paths.project(lang, p.data.key)}>{p.data.title}</a>)}
      </div>
    </aside>
  </div>
</Base>
