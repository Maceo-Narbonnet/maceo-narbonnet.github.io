---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import ProjectCard from '../components/ProjectCard.astro';
import { content, profile, paths, type Lang } from '../data/site';

interface Props { lang: Lang }
const { lang } = Astro.props;
const t = content[lang];
const other: Lang = lang === 'fr' ? 'en' : 'fr';

const projects = (await getCollection('projects', (p) => p.data.lang === lang)).sort((a, b) => a.data.order - b.data.order);
const ids = lang === 'fr'
  ? { projects: 'projets', about: 'parcours', skills: 'competences', contact: 'contact' }
  : { projects: 'projects', about: 'background', skills: 'skills', contact: 'contact' };

const icons = {
  arrow: '<path d="M5 12h14M13 6l6 6-6 6"/>',
  download: '<path d="M12 3v12m0 0l-4-4m4 4l4-4M4 17v2a2 2 0 002 2h12a2 2 0 002-2v-2"/>',
  mail: '<path d="M4 6h16v12H4z"/><path d="M4 7l8 6 8-6"/>',
  github: '<path d="M12 2a10 10 0 00-3.2 19.5c.5.1.7-.2.7-.5v-1.8c-2.8.6-3.4-1.2-3.4-1.2-.4-1.1-1.1-1.5-1.1-1.5-.9-.6.1-.6.1-.6 1 .1 1.5 1 1.5 1 .9 1.6 2.4 1.1 3 .9.1-.7.4-1.1.6-1.4-2.2-.2-4.6-1.1-4.6-5a3.9 3.9 0 011-2.7 3.6 3.6 0 01.1-2.7s.8-.3 2.8 1a9.5 9.5 0 015 0c1.9-1.3 2.8-1 2.8-1a3.6 3.6 0 01.1 2.7 3.9 3.9 0 011 2.7c0 3.9-2.4 4.8-4.6 5 .4.3.7.9.7 1.9v2.8c0 .3.2.6.7.5A10 10 0 0012 2z"/>',
  linkedin: '<path d="M16 8a6 6 0 016 6v7h-4v-7a2 2 0 00-4 0v7h-4v-7a6 6 0 016-6zM2 9h4v12H2z"/><circle cx="4" cy="4" r="2"/>',
};
---

<Base lang={lang} altHref={paths.home[other]}>
  <!-- HERO -->
  <section class="hero">
    <div class="container hero-grid">
      <div>
        <span class="pill">{t.hero.availability}</span>
        <div class="eyebrow" style="margin-top:1.4rem">{t.hero.kicker}</div>
        <h1 set:html={t.hero.title.replace(/(perçoivent et décident|perceive and decide)/, '<span class="accent">$1</span>')} />
        <p class="lead">{t.hero.subtitle}</p>
        <div class="actions">
          <a class="btn btn-primary" href={`#${ids.projects}`}>
            {t.hero.ctaProjects}
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" set:html={icons.arrow} />
          </a>
          <a class="btn" href={profile.cv[lang]} target="_blank" rel="noopener">
            {t.hero.ctaCv}
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" set:html={icons.download} />
          </a>
        </div>
        <p class="meta">{t.hero.location}</p>
      </div>
      <div class="portrait">
        <img src={profile.photo} alt={profile.name} width="300" height="300" fetchpriority="high" />
      </div>
    </div>
  </section>

  <!-- STATS -->
  <section class="container reveal" style="padding-bottom: 1rem">
    <div class="stats">
      {t.stats.map((s) => (
        <div class="stat"><div class="value">{s.value}</div><div class="label">{s.label}</div></div>
      ))}
    </div>
  </section>

  <!-- PROJECTS -->
  <section class="section" id={ids.projects}>
    <div class="container">
      <div class="section-head reveal">
        <div>
          <div class="eyebrow">01</div>
          <h2 class="section-title">{t.sections.projects}</h2>
        </div>
        <p class="section-sub">{t.sections.projectsSub}</p>
      </div>
      <div class="projects-grid">
        {projects.map((p, i) => <ProjectCard project={p} lang={lang} featured={i === 0} />)}
      </div>
    </div>
  </section>

  <!-- ABOUT / EXPERIENCE / EDUCATION -->
  <section class="section" id={ids.about}>
    <div class="container">
      <div class="section-head reveal">
        <div>
          <div class="eyebrow">02</div>
          <h2 class="section-title">{t.sections.about}</h2>
        </div>
      </div>
      <div class="two-col">
        <div class="reveal">
          <div class="about-text">
            {t.about.map((p) => <p>{p}</p>)}
          </div>
          <h3 style="margin-top:2.5rem;font-size:1.05rem;color:var(--muted);font-family:var(--font-mono);font-weight:500;letter-spacing:.08em;text-transform:uppercase">{t.sections.education}</h3>
          <div class="timeline" style="margin-top:1.2rem">
            {t.education.map((e) => (
              <div class="tl-item">
                <div class="period">{e.period}</div>
                <h4>{e.title}</h4>
                <div class="org">{e.org} · {e.place}</div>
              </div>
            ))}
          </div>
        </div>
        <div class="reveal">
          <h3 style="font-size:1.05rem;color:var(--muted);font-family:var(--font-mono);font-weight:500;letter-spacing:.08em;text-transform:uppercase">{t.sections.experience}</h3>
          <div class="timeline" style="margin-top:1.2rem">
            {t.experience.map((e) => (
              <div class="tl-item">
                <div class="period">{e.period}</div>
                <h4>{e.title}</h4>
                <div class="org">{e.org} · {e.place}</div>
                <ul>{e.bullets.map((b) => <li>{b}</li>)}</ul>
                {e.project && <a class="link" href={paths.project(lang, e.project)}>{t.project.readMore} →</a>}
              </div>
            ))}
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- SKILLS -->
  <section class="section" id={ids.skills}>
    <div class="container">
      <div class="section-head reveal">
        <div>
          <div class="eyebrow">03</div>
          <h2 class="section-title">{t.sections.skills}</h2>
        </div>
        <p class="section-sub">{t.languages}</p>
      </div>
      <div class="skills-grid">
        {t.skills.map((g) => (
          <div class="skill-group reveal">
            <h4>{g.name}</h4>
            <ul>{g.items.map((s) => <li class="tag">{s}</li>)}</ul>
          </div>
        ))}
        <div class="skill-group reveal">
          <h4>{lang === 'fr' ? 'Engagement & intérêts' : 'Activities & interests'}</h4>
          <ul class="aside-list">{t.interests.map((s) => <li>{s}</li>)}</ul>
        </div>
      </div>
    </div>
  </section>

  <!-- CONTACT -->
  <section class="section" id={ids.contact}>
    <div class="container">
      <div class="contact-card reveal">
        <div>
          <div class="eyebrow">04</div>
          <h2>{t.contact.title}</h2>
          <p>{t.contact.text}</p>
        </div>
        <div class="contact-links">
          <a class="btn btn-primary" href={`mailto:${profile.email}`}>
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" set:html={icons.mail} />
            {profile.email}
          </a>
          <a class="btn" href={profile.linkedin} target="_blank" rel="noopener">
            <svg viewBox="0 0 24 24" fill="currentColor" set:html={icons.linkedin} />
            {t.contact.linkedin}
          </a>
          <a class="btn" href={profile.github} target="_blank" rel="noopener">
            <svg viewBox="0 0 24 24" fill="currentColor" set:html={icons.github} />
            github.com/{profile.githubHandle}
          </a>
        </div>
      </div>
    </div>
  </section>
</Base>
