---
import { getCollection } from 'astro:content';
import Project from '../../templates/Project.astro';

export async function getStaticPaths() {
  const entries = await getCollection('projects', (p) => p.data.lang === 'fr');
  return entries.map((entry) => ({ params: { slug: entry.data.key }, props: { entry } }));
}
const { entry } = Astro.props;
---
<Project lang="fr" entry={entry} />
